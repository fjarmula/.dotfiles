" Enable relative line numbers for fast vertical movement (e.g., 5j, 12k)
set relativenumber

" Clipboard integration for macOS (share system clipboard with Vim yanks/pastes)
set clipboard+=unnamedplus,unnamed

" Search settings
set ignorecase
set smartcase
set incsearch

" Set Space as the Leader key
let mapleader=" "

" Quick escape from Insert mode via 'jk'
inoremap jk <Esc>

" --- IDEACTION MAPPINGS (via Leader) ---

" Space + r -> Reformat code (PEP 8 / Black)
nmap <leader>r <Action>(ReformatCode)

" Space + f -> Search Everywhere
nmap <leader>f <Action>(SearchEverywhere)

" Space + e -> Toggle Project Tool Window (File Tree)
nmap <leader>e <Action>(ActivateProjectToolWindow)

" Space + b -> Toggle Line Breakpoint
nmap <leader>b <Action>(ToggleLineBreakpoint)

" Space + ca -> Code Actions / Quick Fix (equivalent to Option+Enter)
nmap <leader>ca <Action>(ShowIntentionActions)

" Navigate through code errors/warnings (equivalent to F2 / Shift+F2)
nmap ]g <Action>(GotoNextError)
nmap [g <Action>(GotoPreviousError)
